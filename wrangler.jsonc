{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "kujo-course",
 "compatibility_date": "2026-09-06",
 "workers_dev": false,
 "preview_urls": false,
 "assets": {"directory": "./output", "html_handling": "force-trailing-slash", "not_found_handling": "404-page"},
 "routes": [{"pattern": "kujo.robertdevore.com", "custom_domain": true}]
}
