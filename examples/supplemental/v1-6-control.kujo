func first_positive(records) {
    for record in records {
        if record > 0 { return record }
    }
    return null
}
func nested(records) {
    for row in records {
        for cell in row {
            if cell > 0 { if cell == 4 { return cell } }
        }
    }
    return 0
}
assert(first_positive([4]) == 4)
assert(first_positive([-1, 0, 4]) == 4)
assert(first_positive([-1, 0]) == null)
assert(first_positive([]) == null)
assert(nested([[-1], [0, 4]]) + 1 == 5)
print("loop return verified")
