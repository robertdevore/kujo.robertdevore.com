mut rows := [[1, 2]]
let before := rows
rows[0][1] = 7
assert_equal(before, [[1, 2]])
assert_equal(rows, [[1, 7]])
mut rejected := false
try { rows[0][9] = 8 } except err { rejected = true }
assert(rejected)
assert_equal(rows, [[1, 7]])
mut buffer := utf8_encode("AB")
let snapshot := buffer
buffer[0] = 67
assert_equal(utf8_decode(snapshot), "AB")
assert_equal(utf8_decode(buffer), "CB")
mut total := 0
for byte in buffer { total += byte }
assert_equal(total, 133)
assert_equal(utf8_decode(utf8_encode("é")), "é")
func compare(left, right) { return left["rank"] - right["rank"] }
let items := [{"rank": 2, "id": "a"}, {"rank": 1, "id": "b"}, {"rank": 2, "id": "c"}]
let ordered := sort_by(items, compare)
assert_equal(ordered[0]["id"], "b")
assert_equal(ordered[1]["id"], "a")
assert_equal(ordered[2]["id"], "c")
assert_equal(items[0]["id"], "a")
func replacement(groups) { return "[" + groups[0] + "]" }
assert_equal(regex_replace_with("job12 job34", "[0-9]+", replacement), "job[12] job[34]")
assert_equal(regex_count("job12 job34", "[0-9]+"), 2)
assert_equal(parse_csv_rows("001,2.00\n003,4.50\n"), [["001", "2.00"], ["003", "4.50"]])
assert_equal(format_fixed(1.25, 3), "1.250")
assert_equal(wrapping_add(9223372036854775807, 1), (-9223372036854775807 - 1))
assert_equal([10, 20][1.9], 20)
print("Nested writes, bytes, callbacks, CSV and numeric contracts verified")
